      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/production/endpoint/produit/v1/findStationLotByStationId?stationId={{stationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
