      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/production/endpoint/produit/v1/obtenirStationLots",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "production",
            "endpoint",
            "produit",
            "v1",
            "obtenirStationLots"
          ]
        }
      }
    },
    {
