      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{stationLotId}},\n  \"station\": {\n    \"id\": {{stationId}}\n  },\n  \"lot\": {\n    \"id\": {{lotId}}\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/production/endpoint/produit/v1/modifierStationLot",
